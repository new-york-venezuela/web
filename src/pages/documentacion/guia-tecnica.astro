---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
        title="Guía Técnica — New York Cheese Cake C.A."
        description="Guía técnica para la preparación de nuestros productos congelados y fichas de ingredientes."
>
    <section class="promo-hero">
        <div class="container promo-hero__inner">
            <h1>Guía técnica para la preparación</h1>
            <p class="lead">
                Conoce cómo interpretar nuestra guía técnica y preparar nuestros productos congelados para obtener siempre la mejor calidad.
            </p>
            <a href="/docs/guia-tecnica.pdf" download class="btn btn--solid">Descargar PDF de la Guía</a>
        </div>
    </section>

    <section class="section section--milk">
        <div class="container">
            <div class="text-center" style="margin-bottom: var(--space-l);">
                <h2>Cómo interpretar nuestra ficha técnica</h2>
            </div>
            <div class="promo-points">
                <div>
                    <h3>Mantenimiento</h3>
                    <p>Temperatura de mantenimiento del producto.</p>
                </div>
                <div>
                    <h3>Preparación</h3>
                    <p>Descongelar antes de calentar.</p>
                </div>
                <div>
                    <h3>Temperatura</h3>
                    <p>Precalentar Horno-Plancha y Hornear-Calentar.</p>
                </div>
                <div>
                    <h3>Detalles</h3>
                    <p>Tiempo de cocción y Peso neto del producto.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="productos">
        <div class="container">
            <div class="product-grid">

                <article class="product-card">
                    <h3>Baguettes Kosher</h3>
                    <ul class="specs">
                        <li><strong>Temp:</strong> -18°</li>
                        <li><strong>Descongelado:</strong> 1Hra</li>
                        <li><strong>Horneado:</strong> 200C° a 170C° por 7min</li>
                        <li><strong>Peso:</strong> 220gr / 110gr / 60gr</li>
                    </ul>
                    <p class="ingredients"><strong>Ingredientes:</strong> Harina, Agua, Masa Fermentada, Poolish, Sal, Aceite, Levadura Institucional, Lecitina de Soya, Azúcar, Vinagre.</p>
                </article>

                <article class="product-card">
                    <h3>Bagel Kosher Escalfados</h3>
                    <ul class="specs">
                        <li><strong>Temp:</strong> -18°</li>
                        <li><strong>Descongelado:</strong> 30min</li>
                        <li><strong>Horneado:</strong> 180c° a 180c° por 5min</li>
                        <li><strong>Peso:</strong> 100gr</li>
                    </ul>
                    <p class="ingredients"><strong>Ingredientes:</strong> Harina, Agua, Aceite Girasol, Sal, Azúcar, Miel, Levadura Institucional, Lecitina de Soya, Vinagre.</p>
                </article>

                <article class="product-card">
                    <h3>Croissant y Petit Croissant</h3>
                    <ul class="specs">
                        <li><strong>Temp:</strong> -18°</li>
                        <li><strong>Descongelado:</strong> 30min</li>
                        <li><strong>Horneado:</strong> 170c° a 170c° por 5min o 2-3min</li>
                        <li><strong>Peso:</strong> 80gr / 25gr</li>
                    </ul>
                    <p class="ingredients"><strong>Ingredientes:</strong> Harina, Poolish, Agua, Masa Fermentada, Azúcar, Mantequilla, Miel, Sal, Levadura Institucional, Leche, Ácido Ascórbico.</p>
                </article>

                <article class="product-card">
                    <h3>Bagel Brioche</h3>
                    <ul class="specs">
                        <li><strong>Temp:</strong> -18°</li>
                        <li><strong>Descongelado:</strong> 30min</li>
                        <li><strong>Horneado:</strong> 170c° a 170c° por 3min</li>
                        <li><strong>Peso:</strong> 60gr</li>
                    </ul>
                    <p class="ingredients"><strong>Ingredientes:</strong> Harina, Agua, Huevos, Azúcar, Aceite, Leche, Mantequilla, Margarina, Sal, Miel, Levadura, Institucional, Lecitina de Soya, Vinagre, Ácido Ascórbico.</p>
                </article>

                <article class="product-card">
                    <h3>Pizzas Artesanales</h3>
                    <ul class="specs">
                        <li><strong>Temp:</strong> -18°</li>
                        <li><strong>Descongelado:</strong> 30min</li>
                        <li><strong>Horneado:</strong> 200c° a 180c° por 10-15min</li>
                        <li><strong>Peso:</strong> 550gr (2Unid)</li>
                    </ul>
                    <p class="ingredients"><strong>Descripción:</strong> Elaboradas con prefermentos de masa madre, bajo una fermentación natural que garantiza un sabor auténtico, además de una digestión más ligera.</p>
                </article>

                <article class="product-card">
                    <h3>Pan de Molde 1700g</h3>
                    <ul class="specs">
                        <li><strong>Temp:</strong> Ambiente</li>
                        <li><strong>Peso:</strong> 1700gr</li>
                    </ul>
                    <p class="ingredients"><strong>Ingredientes:</strong> Harina, Agua, Prefermentos de Masa Madre, Azúcar, Aceite Girasol, Sal, Levadura Institucional, Propionato de Calcio, Ácido Sórbico, Vinagre.</p>
                </article>

                <article class="product-card">
                    <h3>Hamburguesa Brioche Kosher</h3>
                    <ul class="specs">
                        <li><strong>Temp:</strong> -18°</li>
                        <li><strong>Descongelado:</strong> 30min</li>
                        <li><strong>Horneado:</strong> 170c° a 170c° por 3min</li>
                        <li><strong>Peso:</strong> 70gr</li>
                    </ul>
                    <p class="ingredients"><strong>Ingredientes:</strong> Harina, Agua, Huevos Kosher, Azúcar, Aceite Girasol Vatel Pro, Margarina Mavesa Light, Sal, Miel Amor& Miel Kosher, Levadura Institucional, Mavesa, Lecitina de Soya, Vinagre, Ácido Ascórbico.</p>
                </article>

                <article class="product-card">
                    <h3>Hamburguesa Brioche</h3>
                    <ul class="specs">
                        <li><strong>Temp:</strong> -18°</li>
                        <li><strong>Descongelado:</strong> 30min</li>
                        <li><strong>Horneado:</strong> 170c° a 170c° por 3min</li>
                        <li><strong>Peso:</strong> 60gr</li>
                    </ul>
                    <p class="ingredients"><strong>Ingredientes:</strong> Harina, Agua, Huevos, Azúcar, Aceite, Leche, Mantequilla, Margarina, Sal, Miel, Levadura, Institucional, Lecitina de Soya, Vinagre, Ácido Ascórbico.</p>
                </article>

                <article class="product-card">
                    <h3>Hamburguesa New York</h3>
                    <ul class="specs">
                        <li><strong>Temp:</strong> -18°</li>
                        <li><strong>Descongelado:</strong> 30min</li>
                        <li><strong>Horneado:</strong> 170c° a 170c° por 3min</li>
                        <li><strong>Peso:</strong> 80gr</li>
                    </ul>
                    <p class="ingredients"><strong>Ingredientes:</strong> Harina, Agua, Aceite Girasol, Margarina, Sal, Azúcar, Miel, Levadura Institucional, Lecitina de Soya, Vinagre, Ácido Ascórbico, Topping Ajonjolí.</p>
                </article>

                <article class="product-card">
                    <h3>Pan de Molde 1700g Brioche</h3>
                    <ul class="specs">
                        <li><strong>Temp:</strong> Ambiente</li>
                        <li><strong>Peso:</strong> 1700gr</li>
                    </ul>
                    <p class="ingredients"><strong>Ingredientes:</strong> Harina, Agua, Huevos, Azúcar, Aceite, Leche, Mantequilla, Margarina, Sal, Miel, Levadura, Institucional, Lecitina de Soya, Vinagre, Ácido Ascórbico.</p>
                </article>

                <article class="product-card">
                    <h3>New York Cheese Cake</h3>
                    <ul class="specs">
                        <li><strong>Temp:</strong> -18°</li>
                        <li><strong>Descongelado:</strong> 30min / 15min</li>
                        <li><strong>Peso:</strong> 1500g / 700g</li>
                    </ul>
                    <p class="ingredients"><strong>Ingredientes:</strong> Queso Crema, Huevos, Azúcar, Crema, Galleta, Margarina, Esencia Vainilla, Especies Mixtas. <br><strong>Toppings:</strong> Mermelada Fresa, Chocolate, Plain.</p>
                </article>

            </div>
        </div>
    </section>

    <section class="section section--milk">
        <div class="container text-center allergens">
            <span class="eyebrow">Aviso de Alérgenos</span>
            <p>Procesado en instalaciones donde se manejan: 🌾 Gluten | 🥛 Lácteos | 🥚 Huevo | 🫛 Soya | 🌿 Sésamo.</p>
        </div>
    </section>
</BaseLayout>

<style>
    .text-center {
        text-align: center;
    }

    .promo-hero {
        padding-block: var(--space-xl);
        text-align: center;
    }

    .promo-hero__inner {
        max-width: 46rem;
    }

    .promo-hero__inner .lead {
        margin-inline: auto;
        margin-bottom: var(--space-m);
    }

    .promo-points {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
        gap: var(--space-l);
        text-align: center;
    }

    .promo-points p {
        font-size: 0.9375rem;
        margin-inline: auto;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
        gap: var(--space-m);
    }

    .product-card {
        background-color: var(--color-white);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-m);
        padding: var(--space-m);
    }

    .product-card h3 {
        margin-top: 0;
        margin-bottom: var(--space-xs);
        font-size: 1.125rem;
    }

    .product-card .specs {
        list-style: none;
        padding: 0;
        margin: 0 0 var(--space-s) 0;
        font-size: 0.875rem;
        color: var(--color-charcoal-soft);
    }

    .product-card .specs li {
        margin-bottom: 0.25rem;
    }

    .product-card .ingredients {
        font-size: 0.875rem;
        margin: 0;
    }

    .allergens {
        max-width: 40rem;
        margin-inline: auto;
    }

    .promo-footer {
        border-top: 1px solid var(--color-border);
        background-color: var(--color-milk);
        padding-block: var(--space-m);
        text-align: center;
    }

    .promo-footer p {
        font-size: 0.875rem;
        margin: 0;
        max-width: none;
        line-height: 1.6;
    }

    .promo-footer a {
        text-decoration: underline;
    }
</style>