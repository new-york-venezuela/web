---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import CTASection from '../components/CTASection.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import WhatsAppDirectLink from '../components/WhatsAppDirectLink.astro';
import { productos } from '../data/catalogo';

const destacados = productos.filter((p) => p.destacado);
---

<BaseLayout
  title="Alimentos New York | Panadería Premium y Cheesecake en Caracas"
  description="Panadería Premium New York en Caracas. Panes artesanales, cheesecake estilo Nueva York, pizzas congeladas y repostería fina. Distribución B2B/B2C, certificado Kosher Parve."
>
  <section class="hero">
    <div class="container hero-content">
      <div class="hero-text">
        <span class="eyebrow">Panadería Premium · Caracas</span>
        <h1>Excelencia premium en cada<br />producto que horneamos.</h1>
        <p class="lead">
          Panadería artesanal y repostería fina con más de 40 años de tradición.
          Desde supermercados hasta restaurantes y hoteles. Conocidos como Panadería Nueva York,
          New York Bakery y especialistas en cheesecake estilo Nueva York. Todo certificado Kosher Parve.
        </p>
        <div class="hero__actions">
          <a href="/catalogo/" class="btn btn--solid">Ver catálogo</a>
          <a href="/solicitar-llamada/" class="btn btn--solid">Solicitar llamada</a>
          <div id="whatsapp-direct-link-container">
            <WhatsAppDirectLink />
          </div>
        </div>
      </div>
      <div class="hero-cta">
        <WhatsAppCTA />
      </div>
    </div>
  </section>

  <section class="section section--milk">
    <div class="container">
      <span class="eyebrow">Nuestro Enfoque</span>
      <h2>Panadería y pastelería premium con más de 40 años.</h2>
      <div class="philosophy">
        <div>
          <h3>Ingredientes Premium</h3>
          <p>
            Materias primas seleccionadas cuidadosamente. Sin aditivos innecesarios,
            sin preservantes artificiales. Certificación Kosher Parve garantiza máxima pureza.
          </p>
        </div>
        <div>
          <h3>Proceso Artesanal</h3>
          <p>
            Cada pan y pastel elaborado con técnicas tradicionales. Prefermentos avanzados
            y control de calidad riguroso en cada etapa de producción.
          </p>
        </div>
        <div>
          <h3>Distribución B2B y B2C</h3>
          <p>
            Panes para supermercados, pizzas congeladas, cheesecake y especialidades
            para restaurantes, hoteles y servicio HORECA profesional.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Selección</span>
      <h2>Los favoritos de la casa</h2>
      <div class="grid">
        {destacados.map((producto) => <ProductCard producto={producto} />)}
      </div>
      <div class="section__cta">
        <a href="/catalogo/" class="btn">Explorar el catálogo completo</a>
      </div>
    </div>
  </section>

  <CTASection
    title="¿Necesitas precios y disponibilidad?"
    description="Nuestro equipo te ofrecerá presupuestos personalizados según tu volumen y tipo de negocio."
    ctaText="Solicitar una Llamada"
  />
</BaseLayout>

<script>
  if (window.posthog?.onFeatureFlags) {
    window.posthog.onFeatureFlags(() => {
      if (window.posthog?.isFeatureEnabled?.('whatsapp-contact-modal')) {
        const container = document.getElementById('whatsapp-direct-link-container');
        if (container) container.style.display = 'none';
      }
    });
  }
</script>

<style>
  .hero {
    padding-block: var(--space-xl);
    text-align: left;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l);
    align-items: start;
  }

  .hero-text {
    /* content flows naturally */
  }

  .hero-cta {
    /* sticky or fixed height */
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-m);
  }

  @media (max-width: 48rem) {
    .hero-content {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
  }

  .philosophy {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-l);
    margin-top: var(--space-m);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-m);
    margin-top: var(--space-m);
  }

  .section__cta {
    margin-top: var(--space-l);
    text-align: center;
  }
</style>
