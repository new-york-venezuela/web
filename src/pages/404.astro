---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada | Alimentos New York"
  description="La página que buscas no existe. Explora el catálogo de Alimentos New York o contáctanos."
  noindex
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Error 404</span>
      <h1>No encontramos esa página</h1>
      <p class="lead">
        Es posible que el enlace haya cambiado. Puedes volver al
        <a href="/">inicio</a>, revisar el <a href="/catalogo/">catálogo de panes y cheesecake</a>,
        ver <a href="/donde-encontrarnos/">dónde encontrarnos en Caracas</a> o
        <a href="/contacto/">escribirnos</a>.
      </p>
    </div>
  </section>
</BaseLayout>
