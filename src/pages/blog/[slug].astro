---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import type { ArticleSchemaInput } from '../../utils/generateProductMetadata';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug || post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('es-VE', { dateStyle: 'long' });

const postSlug = post.data.slug || post.id;
const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: post.data.title, url: `/blog/${postSlug}/` },
];

const articleSchema: ArticleSchemaInput = {
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate,
  author: post.data.author ?? 'eugenio',
  url: `/blog/${postSlug}/`,
  imageUrl: (post.data as any).ogImage,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={(post.data as any).ogImage}
  type="article"
>
  <StructuredData breadcrumbs={breadcrumbs} type="breadcrumb" />
  <StructuredData article={articleSchema} type="article" />

  <article class="post-detail">
    <div class="container">
      <nav class="breadcrumb" aria-label="Migas de pan">
        {breadcrumbs.map((item, idx) => (
          <>
            {idx > 0 && <span class="breadcrumb-sep">/</span>}
            {idx === breadcrumbs.length - 1 ? (
              <span class="breadcrumb-current">{item.name}</span>
            ) : (
              <a href={item.url}>{item.name}</a>
            )}
          </>
        ))}
      </nav>

      <span class="post-date">{dateFormatter.format(post.data.pubDate)}</span>
      <h1>{post.data.title}</h1>

      <div class="post-content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: 2rem;
    font-size: 0.875rem;
    color: var(--color-charcoal-soft);
  }

  .breadcrumb a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb-sep {
    margin: 0 0.5rem;
  }

  .breadcrumb-current {
    color: var(--color-charcoal);
    font-weight: 500;
  }

  .post-date {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .post-detail h1 {
    margin-top: 0;
    margin-bottom: 2rem;
    font-size: 2rem;
    line-height: 1.2;
    max-width: 45rem;
  }

  .post-content {
    max-width: 45rem;
  }

  .post-content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .post-content :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .post-content :global(p) {
    line-height: 1.7;
    color: var(--color-charcoal);
    margin-bottom: 1rem;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    line-height: 1.7;
  }

  @media (max-width: 48rem) {
    .post-detail h1 {
      font-size: 1.5rem;
    }
  }
</style>
