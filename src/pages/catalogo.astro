---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import CTASection from '../components/CTASection.astro';
import { productos } from '../data/catalogo';

const secciones = [
  {
    titulo: 'Para Supermercados',
    nota: 'Panes, repostería, magdalenas y pizzas para distribución en retail. Formato estándar para consumidor final.',
    productos: productos.filter(p => p.categoria_primaria === 'supermarket'),
  },
  {
    titulo: 'Para Foodservice (Restaurantes, Hoteles, Catering)',
    nota: 'Panes especializados, bagels, croissants y grandes formatos. Diseñados para servicios profesionales.',
    productos: productos.filter(p => p.categoria_primaria === 'foodservice'),
  },
];

// Tabla comparativa de la línea de panes, derivada de productos.json (vía catalogo.ts).
const panes = productos.filter((p) => p.categoria_secundaria === 'panes');
---

<BaseLayout
  title="Catálogo | Alimentos New York — Panadería Premium"
  description="Catálogo de Alimentos New York (Panadería Nueva York): panes artesanales, cheesecake estilo Nueva York, pizzas congeladas y repostería. B2B y B2C."
>
  <section class="section intro">
    <div class="container">
      <span class="eyebrow">Catálogo</span>
      <h1>Productos de Alimentos New York</h1>
      <p class="lead">
        Líneas especializadas para supermercados y servicio profesional.
        Consulta precios y disponibilidad en contacto.
      </p>
    </div>
  </section>

  {
    secciones.map((seccion, index) => (
      <section class:list={['section', { 'section--milk': index % 2 === 0 }]}>
        <div class="container">
          <h2>{seccion.titulo}</h2>
          <p class="seccion-nota">{seccion.nota}</p>
          <div class="grid">
            {seccion.productos.map((producto) => (
              <ProductCard producto={producto} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section" aria-labelledby="comparativa-panes">
    <div class="container">
      <h2 id="comparativa-panes">Comparativa de la línea de panes</h2>
      <div class="table-wrap">
        <table class="comparativa">
          <caption>Peso, vida útil y certificación de cada pan de Alimentos New York</caption>
          <thead>
            <tr>
              <th scope="col">Pan</th>
              <th scope="col">Peso</th>
              <th scope="col">Vida útil</th>
              <th scope="col">Certificación</th>
              <th scope="col">Ficha</th>
            </tr>
          </thead>
          <tbody>
            {panes.map((p) => (
              <tr>
                <th scope="row">{p.nombre}</th>
                <td>{p.specs?.peso ?? '—'}</td>
                <td>{p.specs?.tiempoVida ?? '—'}</td>
                <td>{p.certificaciones?.join(', ') || '—'}</td>
                <td><a href={`/productos/${p.id}/`}>Ver ficha<span class="visually-hidden"> de {p.nombre}</span></a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CTASection
    title="Consulta precios y disponibilidad"
    description="Completa nuestro formulario y recibirás una llamada en las próximas 24 horas con presupuestos personalizados según tu tipo de negocio."
    ctaText="Solicitar Información de Precios"
    variant="secondary"
  />

  <section class="section">
    <div class="container pedido">
      <h2>Otras preguntas</h2>
      <p>
        ¿Tienes consultas específicas sobre toppings, volúmenes mínimos o plazos?
        Escríbenos por la página de contacto.
      </p>
      <a href="/contacto/" class="btn">Ir a Contacto</a>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-bottom: var(--space-l);
  }

  .seccion-nota {
    margin-bottom: var(--space-m);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-m);
  }

  .table-wrap {
    overflow-x: auto;
  }

  .comparativa {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .comparativa caption {
    text-align: left;
    padding-bottom: var(--space-s);
    color: var(--color-charcoal-soft);
  }

  .comparativa th,
  .comparativa td {
    border: 1px solid var(--color-border);
    padding: 0.75rem;
    vertical-align: top;
  }

  .comparativa thead th,
  .comparativa tbody th {
    background-color: var(--color-milk);
  }

  .comparativa a {
    display: inline-block;
    min-height: 2.75rem;
    line-height: 2.75rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .pedido {
    text-align: center;
  }

  .pedido p {
    margin-inline: auto;
    margin-bottom: var(--space-m);
  }
</style>
