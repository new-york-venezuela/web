---
import PostHog from '../components/PostHog.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import SeoHead from '../components/SeoHead.astro';
import FloatingContactButton from '../components/FloatingContactButton.astro';
// Fuentes autoalojadas (sin CSS bloqueante de terceros): solo subconjunto latino.
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource-variable/inter/wght.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import cormorant500 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  type?: 'website' | 'product' | 'article';
  /** Oculta la página a los buscadores (p. ej. landings de campaña). */
  noindex?: boolean;
  /** Oculta cabecera y pie para layouts de alta conversión. */
  bare?: boolean;
}

const {
  title,
  description,
  image,
  url = Astro.url.href,
  type = 'website',
  noindex = false,
  bare = false
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <SeoHead
      {title}
      {description}
      {image}
      {url}
      {type}
      {noindex}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cormorant500} as="font" type="font/woff2" crossorigin />
    <PostHog />
    <StructuredData type="organization" />
  </head>
  <body>
    {!bare && <Header />}
    <main id="contenido">
      <slot />
    </main>
    {!bare && <Footer />}
    <FloatingContactButton />
    <script>
      import '../scripts/analytics';
    </script>
    <script>
      const showButton = () => {
        const wrapper = document.getElementById('floating-contact-wrapper');
        if (wrapper) wrapper.style.display = 'block';
      };

      const hideButton = () => {
        const wrapper = document.getElementById('floating-contact-wrapper');
        if (wrapper) wrapper.style.display = 'none';
      };

      if (window.posthog?.onFeatureFlags) {
        window.posthog.onFeatureFlags(() => {
          if (window.posthog?.isFeatureEnabled?.('whatsapp-contact-modal')) {
            showButton();
          } else {
            hideButton();
          }
        });
      } else {
        // Fallback: show button if PostHog hasn't loaded yet
        showButton();
      }
    </script>
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  #floating-contact-wrapper {
    display: none;
  }
</style>
